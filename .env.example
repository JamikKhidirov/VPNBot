# Telegram Bot
BOT_TOKEN=your_telegram_bot_token
ADMIN_IDS=1819756249

# Database
DB_URL=postgresql+asyncpg://vpnbot:vpnbot@localhost:5432/vpnbot

# Redis
REDIS_URL=redis://localhost:6379/0

# Payment: YooKassa (https://yookassa.ru)
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_RETURN_URL=https://t.me/your_bot_username

# Payment: Crypto Bot (https://t.me/CryptoBot)
CRYPTOBOT_TOKEN=your_cryptobot_token

# Trial settings
TRIAL_DAYS=3

# V2Ray/X-UI Panel API (optional - for auto-provisioning)
V2RAY_API_URL=http://localhost:10085/xui/inbound
V2RAY_API_KEY=

# Default server
DEFAULT_SERVER_HOST=vpn.example.com
DEFAULT_SERVER_PORT=443
DEFAULT_PROTOCOL=vless

# Webhook (optional - use polling if empty)
WEBHOOK_HOST=
WEBHOOK_PORT=8080
WEBHOOK_SECRET=

# Payment provider: yookassa, cryptobot, or wallet
PAYMENT_PROVIDER=yookassa

# Manual wallet payment (USDT TRC20)
WALLET_ADDRESS=your_usdt_trc20_wallet_address
WALLET_CURRENCY=USDT (TRC20)
WALLET_NOTE=После отправки USDT нажми «Проверить оплату»
