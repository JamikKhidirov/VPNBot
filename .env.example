# ═══════════════════════════════════════════════════════════
#  VPNBot — конфигурация
#  Минимум для запуска: BOT_TOKEN + ADMIN_IDS + WALLET_ADDRESS
# ═══════════════════════════════════════════════════════════

# ── Telegram ────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=your_telegram_bot_token
# Твой Telegram ID (узнать: @userinfobot). Можно несколько через запятую.
ADMIN_IDS=1819756249

# ── База данных ─────────────────────────────────────────────
# SQLite работает сразу, без установки PostgreSQL.
DB_URL=sqlite+aiosqlite:///./vpnbot.db
# Для продакшена:
# DB_URL=postgresql+asyncpg://vpnbot:vpnbot@localhost:5432/vpnbot

# Redis не обязателен для базовой работы.
REDIS_URL=redis://localhost:6379/0

# ── Подписки ────────────────────────────────────────────────
# Публичный адрес этого компьютера/сервера, где запущен бот.
# Ссылка подписки будет: http://IP:9090/sub/<token>
SUB_DOMAIN=
SUB_PORT=9090

# ── Оплата: USDT TRC20 на кошелёк (без регистрации) ─────────
WALLET_ADDRESS=your_usdt_trc20_wallet_address
WALLET_CURRENCY=USDT (TRC20)
WALLET_NOTE=После оплаты нажми «Проверить оплату» или напиши админу

# ── Оплата: ЮKassa (карты РФ, СБП) ──────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me/your_bot_username

# ── Оплата: Crypto Bot (USDT через Telegram) ────────────────
CRYPTOBOT_TOKEN=

# Провайдер по умолчанию: wallet / yookassa / cryptobot
PAYMENT_PROVIDER=wallet

# ── Пробный период ──────────────────────────────────────────
TRIAL_DAYS=3

# ── 3x-ui панель ────────────────────────────────────────────
# deploy.py сам сгенерирует пароль и запишет сюда.
V2RAY_USER=admin
V2RAY_PASS=
V2RAY_PANEL_PORT=2053
V2RAY_PANEL_SCHEME=http
V2RAY_PANEL_PATH=
V2RAY_API_URL=http://localhost:2053/panel/api/inbounds
V2RAY_API_KEY=

# ── Сервер по умолчанию ─────────────────────────────────────
DEFAULT_SERVER_HOST=vpn.example.com
DEFAULT_SERVER_PORT=443
DEFAULT_PROTOCOL=vless

# ── Webhook (оставь пустым для polling) ─────────────────────
WEBHOOK_HOST=
WEBHOOK_PORT=8080
WEBHOOK_SECRET=

# ── Прокси для Telegram API (если api.telegram.org недоступен) ─
# BOT_PROXY=socks5://user:pass@127.0.0.1:1080
BOT_PROXY=
